PORT=3000

DATABASE_URL=mysql://root:root@localhost:3306/airbnb_dev_hotel
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=root
DATABASE_NAME=airbnb_dev_hotel
connectionLimit=5

ROOM_GENERATION_BATCH_SIZE=100
# Cron expression for the room-availability extension job. Defaults to every 5 minutes if unset.
ROOM_CRON=*/5 * * * *
# How many days of availability to keep generated ahead of the latest existing date. Defaults to 2 if unset.
ROOM_AVAILABILITY_HORIZON_DAYS=2

REDIS_HOST=localhost
REDIS_PORT=6379

# Shared with AuthService and BookingService - all three must use the same value.
ACCESS_TOKEN_SECRET=changeme-access-token-secret
# Shared with BookingService - guards service-to-service room-claim endpoints.
INTERNAL_API_KEY=changeme-internal-api-key
