PORT=3001

DATABASE_URL=mysql://root:root@localhost:3306/airbnb_dev_auth
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=root
DATABASE_NAME=airbnb_dev_auth
connectionLimit=5

SALT_ROUNDS=10

# Shared with HotelService and BookingService - all three must use the same value.
ACCESS_TOKEN_SECRET=changeme-access-token-secret
ACCESS_TOKEN_EXPIRES_IN=1h
# Used only by AuthService.
REFRESH_TOKEN_SECRET=changeme-refresh-token-secret
REFRESH_TOKEN_EXPIRES_IN=7d

HOTEL_SERVICE_URL=http://localhost:3000/api/v1/hotels
BOOKING_SERVICE_URL=http://localhost:3005/api/v1/bookings
