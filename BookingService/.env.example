PORT=3005

DATABASE_URL=mysql://root:root@localhost:3306/airbnb_dev_booking
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=root
DATABASE_NAME=airbnb_dev_booking
connectionLimit=5

REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
BOOKING_LOCK_TTL=60000

# HotelService's rooms API base path (note: /api/v1/rooms, not /api/v1/hotels).
HOTEL_SERVICE_URL=http://localhost:3000/api/v1/rooms

# Shared with AuthService and HotelService - all three must use the same value.
ACCESS_TOKEN_SECRET=changeme-access-token-secret
# Shared with HotelService - sent on service-to-service room-claim calls.
INTERNAL_API_KEY=changeme-internal-api-key
